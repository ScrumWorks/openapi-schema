{
    "name": "scrumworks/openapi-schema",
    "description": "OpenAPI schema reader/generator",
    "license": "MIT",
    "type": "library",
    "keywords": ["openapi"],
    "authors": [
        {
            "name": "Tomas Lang",
            "email": "tomas.lang@gmail.com"
        }
    ],
    "require": {
        "ext-json": "*",
        "nette/di": "^3.0",
        "nette/utils": "^3.1 || ^4.0.4",
        "php": ">=8.5",
        "scrumworks/property-reader": "^0.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-nette": "^2.0",
        "symplify/easy-coding-standard": "^13.3.12",
        "slevomat/coding-standard": "^8.31.3"
    },
    "autoload": {
        "psr-4": {
            "ScrumWorks\\OpenApiSchema\\": [
                "src"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ScrumWorks\\OpenApiSchema\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check-cs": "php vendor/bin/ecs check --ansi",
        "fix-cs": "php vendor/bin/ecs check --fix --ansi",
        "lint": "php vendor/bin/parallel-lint src tests",
        "phpstan" : "vendor/bin/phpstan analyze --ansi",
        "phpunit": "vendor/bin/phpunit",
        "test": ["@lint", "@check-cs", "@phpstan", "@phpunit"]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "phpstan/extension-installer": true
        }
    }
}
